# Database (local: matches docker-compose.yml)
DATABASE_URL=postgres://quiniela:quiniela@localhost:5433/quiniela

# Seal digital (SECRETO — generar con: openssl rand -hex 32 → 64 hex chars = 256 bits)
SEAL_SECRET=

# Auth.js v5 (SECRETO — generar con: openssl rand -base64 32 → ~44 base64 chars = 256 bits)
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Resend (email transaccional + magic links)
RESEND_API_KEY=
EMAIL_FROM="Brake Station <no-reply@brakestation.com.mx>"

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Redis (local: matches docker-compose.yml)
REDIS_URL=redis://localhost:6379

# URLs publicas
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # prod: https://goleadora.brakestation.com.mx
NEXT_PUBLIC_VERIFY_URL=http://localhost:3000/verifica   # prod: https://goleadora.brakestation.com.mx/verifica (ruta interna)
NEXT_PUBLIC_GOLEADORA_URL=http://localhost:3000   # prod: https://goleadora.brakestation.com.mx

# Admin emails (CSV)
ADMIN_EMAILS=admin@example.com

# Plausible Analytics (opcional en dev)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=

# Landing
CONTACT_NOTIFY_EMAILS=admin@example.com
