# ─── Copa Brake Station · Quiniela ───────────────────────────────
# Dev local: copia este archivo a apps/quiniela/.env
# Producción: captura cada variable en Coolify (nunca subas un .env al repo).

# Postgres. Dev: el de docker-compose.yml (puerto 5433).
# Prod: postgres://copa_user:<password>@goleadora-postgres:5432/copa_quiniela
DATABASE_URL=postgres://copa_user:copa_user@localhost:5433/copa_quiniela

# Secretos: uno distinto para cada variable y distinto al Mundial.
# AUTH_SECRET: sesiones de Auth.js.            openssl rand -base64 32
AUTH_SECRET=
# SEAL_SECRET: firma de los sellos/comprobantes. openssl rand -hex 32
#   No lo cambies a mitad del torneo: invalida todos los comprobantes emitidos.
SEAL_SECRET=
# MAGIC_LINK_SECRET: firma de los links de acceso por correo. openssl rand -base64 32
MAGIC_LINK_SECRET=
# ADMIN_COOKIE_SECRET: firma de la cookie del panel admin.   openssl rand -base64 32
ADMIN_COOKIE_SECRET=

# URL pública. Dev: http://localhost:3000 · Prod: https://copa.brakestation.com.mx
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Resend (correo transaccional). Se puede reusar la key del Mundial.
RESEND_API_KEY=
EMAIL_FROM="Copa Brake Station <no-reply@brakestation.com.mx>"

# Cloudflare Turnstile, widget "SGI Secure" (hostname copa.brakestation.com.mx).
# En dev se pueden dejar vacías: la verificación se omite fuera de producción.
# En producción sin TURNSTILE_SECRET_KEY se rechazan registros y logins admin.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Correos que pueden crear su acceso admin desde /admin/login (separados por coma).
ADMIN_EMAILS=comercial@brakestation.com.mx,gerencia@brakestation.com.mx,emurillo@mplabs.com.mx

# Opcional, hoy no se usa: el rate limit vive en memoria (un solo container).
# Si algún día se escala a varias réplicas: redis://goleadora-redis:6379/1
# REDIS_URL=
